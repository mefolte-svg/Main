def Crawl(url_w,depth_w,wordlist_w,actual_depth_w=0):
    if actual_depth_w >= depth_w:
        return
    try:
        with open(wordlist_w, 'r' ) as file:
            for linia in file:
                payload = linia.strip()
                current_url = f"{url_w}/{payload}"
                if not payload:
                        continue
                try:
                    response = requests.get(current_url, timeout=6)
                    timeout_w = response.elapsed.total_seconds()*10
                    if timeout_w >= 5:
                        timeout_w = f"{Fore.GREEN} {response.elapsed.total_seconds()*10} {Fore.RESET}"
                    if response.status_code ==200:
                        print(f"{Fore.GREEN}[+] [{response.status_code}] {Fore.RESET} -> {current_url} [{timeout_w:.1f}]")
                        if PARSER.Output_path:
                            with open(PARSER.Output_path, 'a' ) as O_file:
                                O_file.write(f"[+] [{response.status_code}] -> {current_url} [{timeout_w:.1f}]\n")
                        WA_vulnerability_scanner.Crawl(current_url,PARSER.final_depth,PARSER.wordlist_path,actual_depth_w + 1)
                    elif response.status_code != 200 and response.status_code != 404:
                        print(f"{Fore.BLACK}[+] [{response.status_code}] {Fore.RESET} -> {current_url} [{timeout_w:.1f}]")
                        if PARSER.Output_path:
                            with open(PARSER.Output_path, 'a' ) as O_file:
                                O_file.write(f"[+] [{response.status_code}] -> {current_url} [{timeout_w:.1f}]\n")
                    else:
                        print(f"[-] [{response.status_code}]  -> {current_url} [{timeout_w:.1f}]")
                except KeyboardInterrupt:
                    print("\n[!] Operation interrupted")
                    sys.exit(0)
                except requests.exceptions.Timeout:
                    print("\n[!] Operation timed out")
                    continue
    except KeyboardInterrupt:
        print("\n[!] Operation interrupted")
        sys.exit(0)
    except FileNotFoundError:
        print("\n[!] File not found")
